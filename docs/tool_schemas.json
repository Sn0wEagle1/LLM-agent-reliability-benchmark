              "Иванов",
              "Петров",
              "Сидоров",
              "Смирнов",
              "Кузнецова"
            ],
            "description": "Фамилия сотрудника"
          },
          "priority": {
            "type": "string",
            "enum": [
              "низкий",
              "средний",
              "высокий",
              "критический"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "Новая",
              "В работе",
              "На проверке",
              "Выполнена",
              "Отменена"
            ]
          },
          "text": {
            "type": "string",
            "description": "Фрагмент описания заявки"
          },
          "page": {
            "type": "integer",
            "description": "Номер страницы, начиная с 1"
          }
        },
        "required": []
      }
    }
  },
